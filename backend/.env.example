# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Create a MongoDB Atlas account at https://www.mongodb.com/cloud/atlas
# Create a cluster and get your connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT Configuration
# Generate a secure random string: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_use_openssl_rand_hex_32
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary Configuration
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (NodeMailer + Gmail)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=your_gmail@gmail.com
EMAIL_FROM_NAME=LuminAID

# Admin Email Notifications
ADMIN_EMAIL=admin@luminaid.com
SUPPORT_EMAIL=support@luminaid.com
